# Copy to .env.local for local development, and set the same values in
# Netlify -> Site settings -> Environment variables.
# The anon key is safe to expose in the browser; all write protection is
# enforced by Supabase Row Level Security (see supabase/migrations).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Used only as a hint on the login screen. Real enforcement is the owner's
# user ID stored in the public.site_owner table.
VITE_OWNER_EMAIL=hyadavmp41@gmail.com
